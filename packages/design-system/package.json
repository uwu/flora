{
  "name": "@flora-internal/design-system",
  "version": "0.0.0",
  "private": true,
  "description": "Flora's Vue design system and UnoCSS preset.",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./unocss": {
      "types": "./src/unocss/index.ts",
      "import": "./src/unocss/index.ts",
      "default": "./src/unocss/index.ts"
    },
    "./style.css": "./src/style.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vp build --watch",
    "build": "vue-tsc -p tsconfig.json --noEmit && vp build",
    "typecheck": "vue-tsc -p tsconfig.json --noEmit",
    "lint": "vp lint",
    "format": "vp fmt",
    "check": "vp check"
  },
  "dependencies": {
    "@lucide/vue": "catalog:",
    "@radix-ui/colors": "catalog:",
    "@vueuse/core": "catalog:",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "reka-ui": "catalog:",
    "tailwind-merge": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "typescript": "catalog:",
    "unocss": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vue": "catalog:",
    "vue-tsc": "catalog:"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  }
}
